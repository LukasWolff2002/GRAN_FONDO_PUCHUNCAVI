<!DOCTYPE html>
<html>
  <head>
  <title>GfPuchuncavi</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap CSS desde el CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QrjgEF2VQsRmqjZ2hyyDlwIzLDLYIW9BfEkZlskdJLGmSNwPgAyN6Z9CtYrHy+3k" crossorigin="anonymous">

  <!-- Bootstrap Google Maps -->
  <script async defer
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAoSJuvSWfENxFG6mrD4T-vPtK_giKsGA4&callback=initMap">
</script>

  <!-- Rails CSS -->
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application/navbar"%>
  <link rel="icon" href="<%= asset_path('logo.ico') %>" type="image/x-icon">
  <script src="https://www.eventrid.cl/eventos/fahrradproducciones/gran-fondo-puchuncavi"></script>

</head>


  <body style="background-color: white;">
  <nav style="position: absolute;
            top: 0;
            right: 0;
            z-index: 1;
            background-color: transparent;
            color: rgba(255, 255, 255, 0.85);
            display: flex;
            align-items: flex-end;
            flex-direction: column;
            padding: 1rem 2rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0);">

    <style>
  .nav-text {
    /* Font size scales from a minimum of 0.8rem up to a maximum of 1.8rem,
       based on the viewport width (3.5vw) */
    font-size: clamp(0.8rem, 3.5vw, 1.8rem);
  }
</style>
  <div style="font-weight: bold;">
    <a href="#" class="nav-text" style="text-decoration: none; color: inherit;"> </a>
  </div>
<style>
  .nav-link {
    /* El tamaño de la fuente será de 2vw, pero nunca menor a 0.9rem ni mayor a 3rem */
    font-size: clamp(0.9rem, 3.5vw, 4rem);
    text-align: right;
    display: block;
  }
</style>

  <ul style="list-style: none; display: flex; flex-direction: column; margin: 0; padding: 0;">
    <li style="margin-bottom: 0.5rem;">
      <a href="/home" class="nav-link" style="color: inherit;">Inicio</a>
    </li>
    <li style="margin-bottom: 0.5rem;">
      <a href="/nuestra_historia" class="nav-link" style="color: inherit;">Historia</a>
    </li>
    <li style="margin-bottom: 0.5rem;">
      <a href="/la_carrera" class="nav-link" style="color: inherit;">La Carrera</a>
    </li>
    <li>
      <a href="/contacto" class="nav-link" style="color: inherit;">Contacto</a>
    </li>
  </ul>
</nav>
    <%= yield %>

  <footer style="background-color: var(--primary-color); color: var(--white-color); font-family: 'DIN Condensed', sans-serif; padding: 20px; margin-top: 0px; box-shadow: 0 -4px 8px rgba(0, 0, 0, 0.1);">
  <div class="container text-center">
    <div class="row">
      <!-- Contacto -->
      <div class="col-md-4 mb-3">
        <h5 style="font-size: 1.5rem; font-weight: bold; letter-spacing: 0.1rem;">Contáctanos</h5>
        <p style="margin: 0; font-size: 1.1rem;">Diego Ortiz: <a href="tel:+56 97621 7748" style="color: var(--white-color); text-decoration: underline;">+56 97621 7748</a></p>
        <p style="margin: 0; font-size: 1.1rem;">Giorgio Nattero: <a href="tel:+56 99818 7806" style="color: var(--white-color); text-decoration: underline;">+56 99818 7806</a></p>
      </div>
      
      <!-- Correo Electrónico -->
      <div class="col-md-4 mb-3">
        <h5 style="font-size: 1.5rem; font-weight: bold; letter-spacing: 0.1rem;">Correo Electrónico</h5>
        <p style="font-size: 1.1rem;"><a href="mailto:gfpuchuncavi@gmail.com" style="color: var(--white-color); text-decoration: underline;">gfpuchuncavi@gmail.com</a></p>
      </div>
      
      <!-- Redes Sociales -->
      <div class="col-md-4 mb-3">
        <h5 style="font-size: 1.5rem; font-weight: bold; letter-spacing: 0.1rem;">Síguenos</h5>
        <a href="https://www.instagram.com/gfpuchuncavi/" target="_blank" style="color: var(--white-color); text-decoration: none; font-size: 1.1rem;">
          <i class="bi bi-instagram" style="font-size: 1.5rem; margin-right: 10px;"></i> Instagram
        </a>
      </div>
    </div>
    
    <!-- Derechos de autor -->
    <div class="mt-3">
      <p style="margin: 0; font-size: 1rem; letter-spacing: 0.05rem;">© <%= Time.now.year %> Gran Fondo Puchuncavi</p>
    </div>
  </div>
</footer>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

  </body>
</html>